{
  "name": "widget-panel",
  "version": "0.2.2",
  "description": "Windows 11 sidebar widget panel — Feedly OPML, weather, traffic, stocks",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite --config vite.config.js\" \"wait-on http://localhost:5173 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build && electron-builder",
    "test:reader": "node scripts/test-reader-cleanup.cjs",
    "debug:reader": "node scripts/debug-reader-url.cjs",
    "preview": "electron .",
    "prototype:dev": "vite --config prototype-panel/vite.config.js",
    "prototype:build": "vite build --config prototype-panel/vite.config.js",
    "prototype:capture": "electron prototype-panel/scripts/capture.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "three": "^0.184.0",
    "troika-three-text": "^0.52.4"
  }
}
